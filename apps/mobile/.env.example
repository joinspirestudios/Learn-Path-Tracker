# Mobile environment variables (example only — no secrets here).
# Copy to .env.local and fill in for local development. Never commit .env files.

# Public base URL for the existing Vercel API. This is a public origin, not a secret.
EXPO_PUBLIC_LEARN_PATH_API_BASE_URL=https://learn-path-tracker.vercel.app

# Public Firebase CLIENT config (NOT Firebase Admin secrets). These values are
# safe to ship in a client app. Do not paste a Firebase service account here.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef
